pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    environment {
        PATH = "C:\\Program Files\\Docker\\Docker\\resources\\bin;${env.PATH}"
        DOCKERHUB_CREDENTIALS_ID = 'Andrei_Docker_Id'
        DOCKERHUB_REPO           = 'andrei1033/classroom_attendance_system'
        DOCKER_IMAGE_TAG         = 'latest'
        PROJECT_DIR              = 'OTP1_inclass1_assignment_AndreiTsizikov'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Andrei1033/Suunnittelumallit_TX00EY29-3012'
            }
        }

        stage('Build (package)') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'mvn -B clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'mvn -B test'
                }
            }
        }

        stage('JaCoCo Report') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    jacoco(
                        execPattern:        'target/jacoco.exec',
                        classPattern:       'target/classes',
                        sourcePattern:      'src/main/java',
                        exclusionPattern:   '**/module-info.class'
                    )
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    dir("${env.PROJECT_DIR}") {
                        docker.build("${env.DOCKERHUB_REPO}:${env.DOCKER_IMAGE_TAG}")
                    }
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', env.DOCKERHUB_CREDENTIALS_ID) {
                        docker.image("${env.DOCKERHUB_REPO}:${env.DOCKER_IMAGE_TAG}").push()
                        docker.image("${env.DOCKERHUB_REPO}:${env.DOCKER_IMAGE_TAG}").push('latest')
                    }
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true,
                  testResults:       "${env.PROJECT_DIR}/target/surefire-reports/*.xml"
            archiveArtifacts allowEmptyArchive: true,
                             artifacts:        "${env.PROJECT_DIR}/target/*.jar, ${env.PROJECT_DIR}/target/site/jacoco/**"
        }
        success {
            echo "✅ Build & push OK: ${env.DOCKERHUB_REPO}:${env.DOCKER_IMAGE_TAG}"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}